#!/usr/bin/env python3
"""Stand-in for the official Higgsfield CLI: account status, model get, soul-id, generate cost, generate create --wait."""
import json
import os
import sys
import uuid

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import _stub  # noqa: E402
import fakeimg  # noqa: E402

a = [x for x in sys.argv[1:] if x not in ("--json", "--no-color")]
_stub.log("higgsfield")
BAL = os.path.join(os.environ.get("HOME", "/tmp"), ".stub-higgsfield-credits")
credits = float(open(BAL).read()) if os.path.exists(BAL) else 100.0
COST = float(os.environ.get("STUB_HF_COST", "1.5"))
ASPECTS = ["auto", "1:1", "3:2", "2:3", "4:3", "3:4", "9:16", "16:9"]
SOULS = [
    {"id": "11111111-2222-3333-4444-555555555555", "name": "Demo Creator", "type": "soul_2", "status": "completed"},
    {"id": "66666666-7777-8888-9999-aaaaaaaaaaaa", "name": "Studio Twin", "type": "soul", "status": "completed"},
]

if a[:2] == ["account", "status"]:
    if os.environ.get("STUB_HF_LOGGED_OUT"):
        print("Error: not authenticated", file=sys.stderr); sys.exit(1)
    print(json.dumps({"credits": credits, "subscription_plan_type": "ultimate"}))
elif a[:2] == ["soul-id", "list"]:
    if os.environ.get("STUB_HF_LOGGED_OUT"):
        print("Error: not authenticated", file=sys.stderr); sys.exit(1)
    print(json.dumps(SOULS))
elif a[:2] == ["soul-id", "create"]:
    name = _stub.arg("--name") or "Unnamed"
    print(json.dumps({"id": "99999999-8888-7777-6666-555555555555", "name": name, "type": "soul_2", "status": "queued"}))
elif a[:2] == ["soul-id", "wait"]:
    sid = a[2] if len(a) > 2 else "99999999-8888-7777-6666-555555555555"
    print(json.dumps({"id": sid, "name": "Trained", "type": "soul_2", "status": "completed"}))
elif a[:2] == ["model", "get"]:
    m = a[2]
    if m in ("nano_banana_2_1", "gpt_image_2_6"):
        print(json.dumps({"job_type": m, "params": [
            {"name": "aspect_ratio", "enum": ASPECTS}, {"name": "prompt"}, {"name": "resolution", "enum": ["1k", "2k"]}]}))
    elif m == "text2image_soul_v2":
        print(json.dumps({"job_type": m, "params": [
            {"name": "aspect_ratio", "enum": ["1:1", "16:9", "9:16", "4:3", "3:4", "3:2", "2:3"]},
            {"name": "prompt"},
            {"name": "custom_reference_id"},
            {"name": "style_id"},
            {"name": "image_references"},
            {"name": "quality", "default": "2k", "enum": ["1.5k", "2k"]},
        ]}))
    elif m in ("seedance_2_5", "kling4_0"):
        print(json.dumps({"job_type": m, "type": "video", "params": [
            {"name": "aspect_ratio", "enum": ["auto", "16:9", "9:16", "1:1", "4:3", "3:4"]},
            {"name": "prompt"},
            {"name": "mode", "default": "t2v", "enum": ["t2v", "omni_reference"]},
            {"name": "duration", "default": 5},
            {"name": "resolution", "default": "720p", "enum": ["480p", "720p", "1080p"]},
            {"name": "generate_audio", "default": True},
            {"name": "start_image"},
            {"name": "end_image"},
            {"name": "image_references"},
            {"name": "video_references"},
        ]}))
    else:
        print(f"Error: unknown job type {m}", file=sys.stderr); sys.exit(1)
elif a[:2] == ["generate", "cost"]:
    m = a[2]
    if "STUB_HF_COST" in os.environ:
        c = COST
    elif m == "text2image_soul_v2":
        c = 0.12
    elif m in ("seedance_2_5", "kling4_0"):
        c = 35.0
    else:
        c = COST
    print(json.dumps({"credits": c}))
elif a[:2] == ["generate", "create"]:
    model = a[2]
    if model == "text2image_soul_v2":
        q = _stub.arg("--quality")
        if q and q not in ("1.5k", "2k"):
            print(f"Error: invalid quality {q}", file=sys.stderr); sys.exit(1)
    if model in ("seedance_2_5", "kling4_0"):
        mode = _stub.arg("--mode") or "t2v"
        has_media = any(flag in a for flag in ("--start-image", "--end-image", "--image-references", "--video-references"))
        if mode == "t2v" and has_media:
            print("Error: mode 't2v' does not accept reference media", file=sys.stderr); sys.exit(1)
        if mode == "omni_reference" and not has_media:
            print("Error: mode 'omni_reference' requires reference media", file=sys.stderr); sys.exit(1)
        jid = str(uuid.uuid4())
        if os.environ.get("STUB_HF_VIDEO_STILL_RUNNING"):
            print(json.dumps([{"id": jid, "job_type": model, "status": "in_progress"}]))
            print("Error: wait timeout exceeded", file=sys.stderr)
            sys.exit(1)
        path = os.path.join(os.environ.get("TMPDIR", "/tmp"), f"hf_{jid}.mp4")
        with open(path, "wb") as f:
            f.write(b"\x00\x00\x00\x18ftypmp42\x00\x00\x00\x00mp42isom")
        _stub.painted("higgsfield", path)
        c = COST if "STUB_HF_COST" in os.environ else 35.0
        with open(BAL, "w") as f: f.write(str(credits - c))
        observed = os.environ.get("STUB_HF_OBSERVED", model)
        print(json.dumps([{"id": jid, "job_type": observed, "display_name": "Stub " + observed, "status": "completed",
                           "result_url": "file://" + path}]))
    else:
        aspect = _stub.arg("--aspect_ratio") or "1:1"
        w, h = _stub.DIMS.get(aspect, (1024, 1024))
        jid = str(uuid.uuid4()); path = os.path.join(os.environ.get("TMPDIR", "/tmp"), f"hf_{jid}.png")
        fakeimg.png(path, w, h)
        _stub.painted("higgsfield", path)
        c = COST if "STUB_HF_COST" in os.environ else (0.12 if model == "text2image_soul_v2" else COST)
        with open(BAL, "w") as f: f.write(str(credits - c))
        observed = os.environ.get("STUB_HF_OBSERVED", model)
        print(json.dumps([{"id": jid, "job_type": observed, "display_name": "Stub " + observed, "status": "completed",
                           "result_url": "file://" + path}]))
else:
    print("stub higgsfield: unhandled " + " ".join(a), file=sys.stderr); sys.exit(2)
