#!/usr/bin/env python3
"""Stand-in for the Grok CLI: login listing and --output-format streaming-json with image_gen / image_edit."""
import json
import os
import re
import sys
import time
import uuid

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import _stub  # noqa: E402
import fakeimg  # noqa: E402

a = sys.argv[1:]
_stub.log("grok", model_override=os.environ.get("GROK_IMAGE_GEN_MODEL_OVERRIDE"))

HELP = """Grok Build TUI

Usage: grok [OPTIONS] [PROMPT] [COMMAND]

Options:
      --allow <RULE>
          Permission allow rule (compat alias: --allowedTools)
      --cwd <CWD>
          Working directory
      --deny <RULE>
          Permission deny rule (compat alias: --disallowedTools)
      --disable-web-search
          Disable web search and web fetch tools
      --disallowed-tools <TOOLS>
          Built-in tools to remove (comma-separated)
  -m, --model <MODEL>
          Model ID to use
      --no-subagents
          Disable subagent spawning
      --output-format <OUTPUT_FORMAT>
          Output format for headless mode

          Possible values:
          - plain
          - json
          - streaming-json:          NDJSON: one ACP session update per line, the agent's native format

          [default: plain]

      --prompt-file <PATH>
          Single-turn prompt from a file

      --reasoning-effort <EFFORT>
          Reasoning effort for reasoning models

          [aliases: --effort]

      --tools <TOOLS>
          Built-in tools to allow (comma-separated)
"""

if a[:1] == ["--version"]:
    print("grok " + os.environ.get("STUB_GROK_VERSION", "1.0.41") + " (4220f3b224a6) [stable]")
elif a[:1] in (["--help"], ["-h"]):
    print(_stub.drop_lines(HELP, "STUB_GROK_HELP_DROP"), end="")
elif a[:1] == ["models"]:
    if os.environ.get("STUB_GROK_LOGGED_OUT"):
        print("Not logged in. Run: grok login")
        sys.exit(1)
    print("You are logged in with grok.com.\n\nDefault model: grok-4.7-build-fast\n\nAvailable models:")
    print("  - grok-4.7\n  * grok-4.7-build-fast (default)\n  - grok-4.6")
    _stub.chatty()
elif "-p" in a:  # a text-only call (bin/think)
    if os.environ.get("STUB_THINK_FAIL"):
        sys.exit(1)
    ans = os.environ.get("STUB_THINK_ANSWER")
    if ans is None:
        m = re.search(r"exactly (\d+) frames", _stub.arg("-p"))
        ans = json.dumps({"frames": [f"stub frame {i + 1}" for i in range(int(m.group(1)))]}) if m else "stub answer"
    _stub.log("grok" + "-think", answer=ans)
    print(ans)
elif "--prompt-file" in a:
    hang = os.environ.get("STUB_GROK_HANG")
    if hang:
        time.sleep(float(hang))  # never answers: the painter's own timeout must end the call
        sys.exit(1)
    if os.environ.get("STUB_GROK_BALANCE"):  # the CLI's own usage balance is empty (real 2026-09-26)
        print('Error: Internal error: {\n  "message": "API error (status 402 Payment Required): '
              'Grok Build usage balance exhausted",\n  "http_status": 402\n}', file=sys.stderr)
        sys.exit(1)
    task = open(_stub.arg("--prompt-file")).read()
    tool = _stub.arg("--tools")
    prompt = re.search(r"<<<PROMPT\n(.*)\nPROMPT>>>", task, re.S).group(1)
    aspect = re.search(r'aspect_ratio = "([^"]+)"', task).group(1)
    m = re.search(r"image = \[(.*?)\];", task)
    images = re.findall(r'"([^"]+)"', m.group(1)) if m else []
    _stub.log("grok-paint", tool=tool, aspect=aspect, images=len(images))
    sid = str(uuid.uuid4())
    if tool == "reference_to_video":
        if os.environ.get("STUB_GROK_ZDR"):
            msg = ("Video generation tools are unavailable under zero data retention (ZDR). To enable, either turn off "
                   "/privacy mode to disable ZDR or supply a user-hosted storage bucket")
            for e in ({"type": "tool_call", "toolName": tool, "toolCallId": "call-1", "rawInput": {"prompt": prompt}},
                      {"type": "tool_call_update", "toolCallId": "call-1", "status": "failed",
                       "rawOutput": {"error": "tool_execution_failed", "message": msg}},
                      {"type": "end", "sessionId": sid}):
                print(json.dumps(e), flush=True)
            sys.exit(0)
        vid_dir = os.path.join(os.path.expanduser("~/.grok/sessions/stub"), sid, "videos")
        os.makedirs(vid_dir, exist_ok=True)
        saved = os.path.join(vid_dir, "1.mp4")
        with open(saved, "wb") as fh:
            fh.write(b"\x00\x00\x00\x18ftypmp42\x00\x00\x00\x00mp42isom" + b"\x00" * 2048)
        _stub.painted("grok", saved)
        first = re.search(r'first_frame = "([^"]+)"', task)
        raw = {"prompt": prompt, "aspect_ratio": aspect}
        if first:
            raw["first_frame"] = first.group(1)
        for e in ({"type": "tool_call", "toolName": tool, "toolCallId": "call-1", "rawInput": raw},
                  {"type": "tool_call_update", "toolCallId": "call-1", "status": "completed",
                   "rawOutput": {"type": "ReferenceToVideo", "path": saved, "filename": "1.mp4"}},
                  {"type": "end", "sessionId": sid}):
            print(json.dumps(e), flush=True)
        sys.exit(0)
    img_dir = os.path.join(os.path.expanduser("~/.grok/sessions/stub"), sid, "images")
    os.makedirs(img_dir, exist_ok=True)
    w, h = _stub.DIMS[aspect]
    saved = os.path.join(img_dir, "1.jpg")
    fakeimg.jpeg(saved, w, h, b"c2pa xAI Grok Imagine SpaceXAI trainedAlgorithmicMedia")
    _stub.painted("grok", saved)
    raw = {"prompt": prompt, "aspect_ratio": aspect}
    if images:
        raw["image"] = images
    for e in ({"type": "tool_call", "toolName": tool, "toolCallId": "call-1", "rawInput": raw},
              {"type": "tool_call_update", "toolCallId": "call-1", "status": "completed", "rawOutput": {"path": saved}},
              {"type": "text", "data": saved},
              {"type": "end", "sessionId": sid}):
        print(json.dumps(e), flush=True)
else:
    print("grok stub: unhandled " + " ".join(a), file=sys.stderr)
    sys.exit(2)
