#!/usr/bin/env python3
"""Stand-in for the Antigravity CLI (agy): model listing and -p stream-json with generate_image into the profile."""
import json
import os
import re
import sys
import time
import uuid

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import _stub  # noqa: E402
import fakeimg  # noqa: E402

a = sys.argv[1:]
_stub.log("agy")
profile = _stub.arg("--gemini_dir") or os.path.expanduser("~/.gemini")
# Go flags take both --gemini_dir=DIR and --gemini_dir DIR; drop either form.
cmd = []
skip_value = False
for v in a:
    if skip_value:
        skip_value = False
        continue
    if v.startswith("--gemini_dir"):
        if "=" not in v:
            skip_value = True
        continue
    cmd.append(v)

HELP = """Usage of agy:
  --add-dir                       Add a directory to the workspace (repeatable) (default [])
  --dangerously-skip-permissions  Auto-approve all tool permission requests without prompting
  --disable-slash-commands        Disable slash command and skill expansion in print mode
  --model                         Model for the current CLI session
  --output-format                 Output format for print mode (text, json, stream-json) (default text)
  -p                              Short alias for --print
  --print                         Run a single prompt non-interactively and print the response
  --print-timeout                 Optional time limit for print mode; 0 waits until the turn completes (default 0s)
  --sandbox                       Run in a sandbox with terminal restrictions enabled
"""

if cmd[:1] == ["--version"]:
    print(os.environ.get("STUB_AGY_VERSION", "1.2.11"))
elif cmd[:1] == ["--help"] or cmd[:1] == ["-h"]:
    print(_stub.drop_lines(HELP, "STUB_AGY_HELP_DROP"), end="")
elif cmd[:1] == ["models"]:
    if os.environ.get("STUB_AGY_LOGGED_OUT"):
        print("Please sign in: run agy")
        sys.exit(1)
    # Linux agy keeps its login as a file inside the profile (macOS uses the Keychain).
    if os.environ.get("STUB_AGY_FILE_TOKEN") and not os.path.exists(
            os.path.join(profile, "antigravity-cli", "antigravity-oauth-token")):
        print("Error: Please sign in to view available models.")
        sys.exit(1)
    fails = int(os.environ.get("STUB_AGY_MODELS_FAIL", "0"))  # the first N lookups fail, like a network blip
    if fails:
        count = os.path.join(os.path.expanduser("~"), ".stub-agy-models-calls")
        n = int(open(count).read()) if os.path.exists(count) else 0
        with open(count, "w") as f:
            f.write(str(n + 1))
        if n < fails:
            print("Fetching available models...\nError: failed to fetch models (network unreachable)")
            sys.exit(1)
    print("Fetching available models...")
    for v in ("3.8", "3.7"):
        for e in ("high", "medium", "low"):
            print(f"gemini-{v}-flash-{e}\tGemini {v} Flash ({e.title()})")
    print("gemini-3.1-pro-high\tGemini 3.1 Pro (High)")
    _stub.chatty()
elif "-p" in cmd and _stub.arg("--output-format") == "text":  # a text-only call (bin/think)
    if os.environ.get("STUB_THINK_FAIL"):
        sys.exit(1)
    ans = os.environ.get("STUB_THINK_ANSWER")
    if ans is None:
        m = re.search(r"exactly (\d+) frames", _stub.arg("-p"))
        ans = json.dumps({"frames": [f"stub frame {i + 1}" for i in range(int(m.group(1)))]}) if m else "stub answer"
    _stub.log("agy" + "-think", answer=ans)
    print(ans)
elif "-p" in cmd:
    task = _stub.arg("-p")
    m = re.search(r'AspectRatio to "([0-9:]+)"', task)
    aspect = m.group(1) if m else "1:1"
    refs = re.findall(r'"(/[^"]+)"', task.split("\n", 1)[0]) if task.startswith("There are") else []
    cid = str(uuid.uuid4())
    brain = os.path.join(profile, "antigravity-cli", "brain", cid)
    os.makedirs(os.path.join(brain, ".system_generated", "logs"), exist_ok=True)
    w, h = _stub.DIMS[aspect]
    saved = os.path.join(brain, f"door_image_{int(time.time())}.jpg")
    fakeimg.jpeg(saved, w, h, b"c2pa Google C2PA Core Generator Library Created by Google Generative AI")
    _stub.painted("agy", saved)
    prompt = re.search(r"PROMPT: (.*?)\n\nRequirements:", task, re.S).group(1)
    with open(os.path.join(brain, ".system_generated", "logs", "transcript_full.jsonl"), "w") as f:
        f.write(json.dumps({"tool_calls": [{"name": "generate_image", "args": {
            "Prompt": prompt, "AspectRatio": aspect, "ImageName": "door_image", "ImagePaths": refs}}]}) + "\n")
        f.write(json.dumps({"media": [{"mime_type": "image/jpeg", "uri": "file://" + saved}]}) + "\n")
    conv = os.path.join(profile, "antigravity-cli", "conversations")
    os.makedirs(conv, exist_ok=True)
    name = b"gemini-3.1-flash-image"
    with open(os.path.join(conv, cid + ".db"), "wb") as f:
        f.write(b"SQLite format 3\x00" + b"\x0a" + bytes([len(name)]) + name + b"\x00")
    print(json.dumps({"init": {"conversation_id": cid}}))
    print(json.dumps({"step_update": {"conversation_id": cid, "tool_name": "generate_image", "state": "DONE",
                                      "duration_seconds": 11.5}}))
    print(json.dumps({"result": {"conversation_id": cid, "status": "SUCCESS", "response": saved}}))
else:
    print("agy stub: unhandled " + " ".join(a), file=sys.stderr)
    sys.exit(2)
