#!/usr/bin/env bash
# doctor: which subpowers work on this machine, and exactly what to fix.
#
# Usage: subpowers doctor [--fix] [--smoke]
#   --fix    run `codex update` when the ChatGPT painter's CLI is behind
#   --smoke  also make one real test image per connected painter (uses your plan's quota)
# Exit 0 when at least one painter is ready.
set -uo pipefail

# Per-user defaults: KEY=value lines in ~/.subpowers/config ($SUBPOWERS_HOME/config),
# e.g. CHATGPT_IMAGE_DRIVERS=gpt-6-sol to keep a frontier model's quota free.
# Only painter keys are read; a variable already set in the environment wins.
sp_cfg="${SUBPOWERS_HOME:-$HOME/.subpowers}/config"
if [[ -f "$sp_cfg" ]]; then
  while IFS='=' read -r sp_k sp_v || [[ -n "$sp_k" ]]; do
    [[ "$sp_k" =~ ^(CHATGPT|AGY|GROK)_IMAGE_[A-Z_]+$ ]] || continue
    sp_v="${sp_v%\"}"; sp_v="${sp_v#\"}"
    [[ -z "${!sp_k+x}" ]] && export "$sp_k=$sp_v"
  done < "$sp_cfg"
fi

src="${BASH_SOURCE[0]}"
while [[ -L "$src" ]]; do
  d="$(cd "$(dirname "$src")" && pwd)"; src="$(readlink "$src")"
  [[ "$src" != /* ]] && src="$d/$src"
done
here="$(cd "$(dirname "$src")" && pwd)"
skill="$(cd "$here/.." && pwd)"

fix=""; smoke=""
for a in "$@"; do
  case "$a" in
    --fix) fix=1 ;;
    --smoke) smoke=1 ;;
    *) echo "usage: subpowers doctor [--fix] [--smoke]" >&2; exit 2 ;;
  esac
done

pass() { printf '  PASS  %s\n' "$1"; }
warn() { printf '  WARN  %s\n' "$1"; }
info() { printf '  INFO  %s\n' "$1"; }
fail() { printf '  FAIL  %s\n' "$1"; }
off()  { printf '  OFF   %s\n' "$1"; }
ready=()

echo "subpowers doctor ($skill)"
if command -v python3 >/dev/null 2>&1; then pass "python3: $(python3 --version 2>&1)"
else fail "python3 missing -> xcode-select --install (macOS) or install Python 3"; fi
ops="$(python3 "$here/imgops" backend 2>/dev/null)"
if [[ "$ops" == pillow || "$ops" == sips ]]; then pass "image ops: $ops (exact --size and format conversion work)"
else warn "no image ops (no Pillow, no sips): images arrive in the painter's own format and size -> python3 -m pip install --user pillow"; fi
if python3 -c 'import PIL' >/dev/null 2>&1; then pass "Pillow $(python3 -c 'import PIL; print(PIL.__version__)' 2>/dev/null) (council side-by-side sheet, slideshow, grok reference padding)"
else warn "Pillow missing: painting works, but the council side-by-side sheet, slideshow and grok reference padding need it -> python3 -m pip install --user pillow"; fi

echo "ChatGPT painter (OpenAI image model, your ChatGPT plan)"
if ! command -v codex >/dev/null 2>&1; then
  off "codex CLI not installed -> npm install -g @openai/codex   (or: brew install codex)"
else
  cg_ok=1
  pass "codex CLI: $(codex --version 2>/dev/null) at $(command -v codex)"
  if [[ -n "$fix" ]]; then msg="$(bash "$here/update-codex" --apply 2>&1)"; rc=$?
  else msg="$(bash "$here/update-codex" 2>&1)"; rc=$?; fi
  msg="$(printf '%s' "$msg" | tail -n 1)"
  case $rc in
    0) pass "$msg" ;;
    1) warn "$msg  (subpowers doctor --fix runs it; the painter also does it once a day)" ;;
    *) warn "$msg" ;;
  esac
  chain="${CHATGPT_IMAGE_DRIVERS:-${GPT_IMAGE_MODELS:-$(python3 "$here/resolve-drivers" 2>/dev/null || echo default)}}"
  # Captured before grep: under pipefail a CLI killed by SIGPIPE reads as a failed check.
  login_out="$(codex login status 2>&1)"
  if grep -qi "chatgpt" <<<"$login_out"; then
    pass "login stored: ChatGPT (your plan pays; no API key)"
    # A stored login is not a working login: ask OpenAI one tiny question the way
    # chatgpt-image asks (its isolation flags, its first helper model) and only
    # PASS on a real answer. Otherwise a user config.toml or AGENTS.md can make
    # this check pass or cost what the painter never would.
    iso=(); cenv=(env -u OPENAI_API_KEY -u OPENAI_BASE_URL -u CODEX_API_KEY)
    if [[ -z "${SUBPOWERS_CODEX_KEEP_CONFIG:-}" ]]; then
      iso=(-c 'model_provider="openai"' -c 'openai_base_url="https://chatgpt.com/backend-api/codex"' -c 'mcp_servers={}'
           -c 'project_doc_max_bytes=0' -c 'features.shell_tool=false')
      exec_help="$(codex exec --help 2>/dev/null)"
      grep -q -- '--ignore-user-config' <<<"$exec_help" && iso+=(--ignore-user-config)
    else
      cenv=()
    fi
    ldir="$(mktemp -d "${TMPDIR:-/tmp}/subpowers-live.XXXXXX")"
    for m in ${chain//:/ }; do
      margs=(-c 'model_reasoning_effort="low"'); [[ "$m" != default ]] && margs+=(-m "$m")
      live="$(cd "$ldir" && perl -e 'alarm shift; exec @ARGV' "${SUBPOWERS_LIVE_TIMEOUT:-120}" \
        ${cenv[@]+"${cenv[@]}"} codex exec ${iso[@]+"${iso[@]}"} "${margs[@]}" --json --skip-git-repo-check \
        "Reply with exactly: pong" </dev/null 2>/dev/null || true)"
      # Like chatgpt-image: the next helper only when this one is dry or unavailable.
      grep -q '"turn.completed"' <<<"$live" && break
      grep -qiE 'usage limit|usage_limit|rate_limit|quota|model_not_found|does not exist|not supported|unsupported model|not available|newer version' <<<"$live" || break
    done
    if grep -q '"turn.completed"' <<<"$live"; then
      pass "live check: ChatGPT answered a real request (helper: $m)"
    else
      why="$(printf '%s\n' "$live" | python3 -c '
import json, re, sys
msg = ""
for line in sys.stdin:
    try: e = json.loads(line)
    except Exception: continue
    if e.get("type") == "turn.failed": msg = (e.get("error") or {}).get("message", "")
    elif e.get("type") == "error" and not msg: msg = e.get("message", "")
msg = re.sub(r"sk-[A-Za-z0-9*_-]{4,}", "sk-***", msg)
print((msg or "no answer before the timeout").split(", url:")[0][:160])' 2>/dev/null)"
      case "$(tr '[:upper:]' '[:lower:]' <<<"$why")" in
        *"usage limit"*|*quota*|*"rate limit"*|*rate_limit*|*429*|*"too many requests"*)
          fail "live check: the ChatGPT plan's usage is spent or rate limited (${why}) -> it resets on its own; meanwhile use another painter" ;;
        *401*|*403*|*unauthori*|*forbidden*|*expired*|*token*|*login*|*"log in"*|*"sign in"*)
          fail "live check: OpenAI rejected the login (${why}) -> codex logout && codex login" ;;
        *"error sending request"*|*network*|*connect*|*dns*|*resolve*|*"timed out"*|*"no answer"*|*disconnected*)
          fail "live check: could not reach OpenAI, a network problem (${why}) -> check the connection or proxy, then run subpowers doctor again" ;;
        *)
          fail "live check: OpenAI rejected a real request (${why}) -> run subpowers doctor again; if it repeats, codex logout && codex login" ;;
      esac
      cg_ok=""
    fi
  else
    fail "not logged in with ChatGPT -> codex login   (choose Sign in with ChatGPT)"; cg_ok=""
  fi
  feats="$(codex features list 2>/dev/null)"
  if awk '$1=="image_generation" && $NF=="true"{on=1} END{exit !on}' <<<"$feats"; then pass "image_generation feature is on"
  else fail "image_generation feature is off -> codex features enable image_generation"; cg_ok=""; fi
  if [[ -n "${CHATGPT_IMAGE_DRIVERS:-${GPT_IMAGE_MODELS:-}}" ]]; then pass "helper models, your choice (CHATGPT_IMAGE_DRIVERS): ${chain//:/ > }"
  elif [[ "$chain" == "default" ]]; then warn "no codex model list yet (it appears after the first codex run); using codex's default"
  else pass "helper models, newest first: ${chain//:/ > }"; fi
  info "painter = OpenAI's current image model, chosen by OpenAI on every call"
  [[ -n "$cg_ok" ]] && ready+=(chatgpt)
fi

echo "Antigravity painter (Google Nano Banana 2, your Google AI plan)"
AGY="$(command -v agy 2>/dev/null || true)"; [[ -z "$AGY" && -x "$HOME/.local/bin/agy" ]] && AGY="$HOME/.local/bin/agy"
if [[ -z "$AGY" ]]; then
  off "Antigravity CLI not installed -> curl -fsSL https://antigravity.google/cli/install.sh | bash   then run agy once"
else
  pass "agy: $("$AGY" --version 2>/dev/null | head -n 1) at $AGY"
  models="$("$AGY" models 2>&1 || true)"
  if grep -qE '^gemini-[0-9]' <<<"$models"; then
    # The helper antigravity-image will pick: newest gemini-X-flash at AGY_IMAGE_EFFORT.
    effort="${AGY_IMAGE_EFFORT:-high}"
    if [[ -n "${AGY_IMAGE_DRIVERS:-}" ]]; then helper="${AGY_IMAGE_DRIVERS%%:*}"
    else helper="$(python3 -c '
import re, sys
effort, found = sys.argv[1], {}
for line in sys.stdin:
    m = re.match(r"(gemini-(\d+(?:\.\d+)*)-flash-(low|medium|high))\s", line)
    if m: found.setdefault(tuple(int(x) for x in m.group(2).split(".")), {})[m.group(3)] = m.group(1)
if found:
    v = found[max(found)]; print(v.get(effort) or v.get("high") or next(iter(v.values())))
' "$effort" <<<"$models" 2>/dev/null)"; fi
    pass "logged in (helper model: ${helper:-agy default}, effort ${effort})"
    info "painter = Google's image model, chosen by Google on every call (Nano Banana 2 as of 2026-09)"
    ready+=(antigravity)
  else
    fail "agy is installed but not logged in -> run agy once in a terminal and sign in"
  fi
fi

echo "Grok painter (xAI Grok Imagine, your SuperGrok plan)"
if ! command -v grok >/dev/null 2>&1; then
  off "Grok CLI not installed -> curl -fsSL https://x.ai/cli/install.sh | bash   then grok login"
else
  pass "grok: $(grok --version 2>/dev/null | head -n 1) at $(command -v grok)"
  gm="$(cd "${TMPDIR:-/tmp}" && env -u XAI_API_KEY -u GROK_CODE_XAI_API_KEY GROK_DISABLE_API_KEY_AUTH=1 grok models 2>&1 || true)"
  if grep -qi "logged in with grok.com" <<<"$gm"; then
    gdrv="$(printf '%s\n' "$gm" | sed -nE 's/^[[:space:]]*[-*][[:space:]]+([A-Za-z0-9._-]+).*/\1/p' | grep -vi fast | head -n 1)"
    pass "logged in with grok.com (helper model: ${gdrv:-grok default}; API-key auth is switched off for every call)"
    info "painter = xAI's Grok Imagine; images ask for ${GROK_IMAGE_MODEL-grok-imagine-image-2.0}, video for grok-imagine-video-1.5 (set by the grok CLI)"
    ready+=(grok)
  else
    fail "grok is installed but not logged in with grok.com -> grok login"
  fi
fi

# Higgsfield: opt-in. It spends plan credits per image, so auto and council never use it.
echo "Higgsfield painter (opt-in: --painter higgsfield, spends your Higgsfield plan credits)"
if ! command -v higgsfield >/dev/null 2>&1; then
  info "higgsfield CLI not installed (optional) -> brew install higgsfield   then higgsfield auth login"
else
  pass "higgsfield: $(higgsfield --version 2>/dev/null | head -n 1 | awk '{print $2}') at $(command -v higgsfield)"
  hst="$(perl -e 'alarm shift; exec @ARGV' 30 higgsfield account status --json 2>/dev/null || true)"
  hcred="$(python3 -c 'import json,sys;d=json.load(sys.stdin);print(d.get("credits",""), d.get("subscription_plan_type",""))' <<<"$hst" 2>/dev/null || true)"
  if [[ -n "$hcred" ]]; then
    pass "signed in (${hcred#* } plan, ${hcred%% *} credits; browser sign-in, no API key)"
    info "model = ${HIGGSFIELD_IMAGE_MODEL:-nano_banana_2_1} (job id named on every call); each image is priced first and capped at ${HIGGSFIELD_IMAGE_MAX_CREDITS:-2} credits"
  else
    info "higgsfield is installed but not signed in -> higgsfield auth login (optional painter)"
  fi
fi

# HyperFrames: only for `--into PROJECT` (painting straight into a video project). Never upgraded from here.
echo "HyperFrames (video editor, for --into PROJECT)"
hf_ver=""; hf_latest=""
if command -v hyperframes >/dev/null 2>&1; then
  hf_ver="$(cd "${TMPDIR:-/tmp}" && hyperframes --version 2>/dev/null | head -n 1 | tr -d '[:space:]')"
  pass "hyperframes CLI: ${hf_ver:-?} at $(command -v hyperframes)"
  if command -v npm >/dev/null 2>&1; then
    hf_latest="$(cd "${TMPDIR:-/tmp}" && perl -e 'alarm shift; exec @ARGV' 20 npm view hyperframes version 2>/dev/null | tail -n 1 | tr -d '[:space:]')"
  fi
  if [[ -z "$hf_latest" ]]; then
    info "could not read the npm latest of hyperframes (offline or npm missing)"
  elif [[ "$hf_ver" == "$hf_latest" ]]; then
    pass "hyperframes is the npm latest ($hf_latest)"
  elif [[ "$(printf '%s\n%s\n' "$hf_ver" "$hf_latest" | sort -V | tail -n 1)" == "$hf_latest" ]]; then
    warn "hyperframes $hf_ver is behind the npm latest $hf_latest -> upgrade when your projects are ready: npm install -g hyperframes@$hf_latest (subpowers never upgrades it for you)"
  else
    info "hyperframes $hf_ver is newer than the npm latest $hf_latest"
  fi
else
  info "hyperframes CLI not installed (only needed for --into) -> npm install -g hyperframes"
fi

echo "Versions"
v_codex="$(codex --version 2>/dev/null | head -n 1 | sed 's/^codex-cli //')"
v_agy=""; [[ -n "${AGY:-}" ]] && v_agy="$("$AGY" --version 2>/dev/null | head -n 1)"
v_grok="$(grok --version 2>/dev/null | head -n 1 | awk '{print $2}')"
g_latest=""
if [[ -n "$v_grok" ]]; then
  g_latest="$(cd "${TMPDIR:-/tmp}" && perl -e 'alarm shift; exec @ARGV' 30 grok update --check --json 2>/dev/null \
    | python3 -c 'import json,sys
try: j=json.load(sys.stdin); print(j.get("latestVersion") or "")
except Exception: pass' 2>/dev/null)"
fi
info "codex ${v_codex:-not installed} (freshness: the ChatGPT painter line above) | agy ${v_agy:-not installed} (agy has no read-only update check) | grok ${v_grok:-not installed}${g_latest:+ (latest $g_latest)} | hyperframes ${hf_ver:-not installed}${hf_latest:+ (npm latest $hf_latest)}"
if [[ -n "$v_grok" && -n "$g_latest" && "$v_grok" != "$g_latest" ]]; then warn "grok $v_grok is behind $g_latest -> grok update"; fi

echo "Where agents find it"
for d in "$HOME/.claude/skills/subpowers" "$HOME/.agents/skills/subpowers" "$HOME/.codex/skills/subpowers"; do
  if [[ -f "$d/SKILL.md" ]]; then pass "$d"; else warn "not linked at $d (bash install.sh links it)"; fi
done
if [[ -f "$HOME/.claude/skills/subpowers-hyperframes/SKILL.md" ]]; then pass "HyperFrames app chat skill: $HOME/.claude/skills/subpowers-hyperframes"
else info "HyperFrames app chat skill not linked (optional) -> ln -s $skill/hyperframes/subpowers-hyperframes $HOME/.claude/skills/subpowers-hyperframes"; fi
if command -v subpowers >/dev/null 2>&1; then pass "subpowers command on PATH"
else warn "subpowers command not on PATH (agents can still run $here/subpowers; add ~/.local/bin to PATH to type it)"; fi
# Informational, never a failure: the drift radar is optional.
if [[ -f "$HOME/Library/LaunchAgents/com.subpowers.canary.plist" ]]; then
  info "canary LaunchAgent installed (daily 07:15 vendor-drift check)"
else
  info "canary LaunchAgent not installed (optional) -> subpowers canary --install-launchagent"
fi

if [[ -n "$smoke" ]]; then
  for p in ${ready[@]+"${ready[@]}"}; do
    out="${TMPDIR:-/tmp}/subpowers-smoke-$p.png"
    echo "  ....  $p: making one test image"
    if got="$(bash "$here/${p}-image" "a red ceramic coffee mug on a white table, soft window light, product photo, no text" "$out")"; then
      pass "$p smoke image: $got (receipt: ${got%.*}.prompt.txt)"
    else
      fail "$p smoke image failed (see the error above)"
    fi
  done
fi

if [[ ${#ready[@]} -gt 0 ]]; then echo "READY: your agents can make images with: ${ready[*]}"; exit 0; fi
echo "NOT READY: connect at least one painter (see the FAIL/OFF lines), then run subpowers doctor again."
exit 1
