    "name": "subpowers",
    "version": "0.5.0",
}

SUPPORTED_PROTOCOLS = {"2024-11-05", "2025-03-26", "2025-06-18"}
REF_NAME_RE = re.compile(r"^[A-Za-z0-9._-]+$")

