def expect_str_list(args, key):
    val = args.get(key)
    if val is None:
        return []
    if not isinstance(val, list) or not all(isinstance(x, str) for x in val):
        raise ValueError(f"'{key}' must be an array of strings")
    return val


def expect_bool(args, key, default=False):
    val = args.get(key, default)
    if val is None:
        return default
    if not isinstance(val, bool):
        raise ValueError(f"'{key}' must be a JSON boolean (true or false)")
    return val


def validate_output_path(path_val):
    if not isinstance(path_val, str) or not path_val.strip():
        raise ValueError("'output_path' must be a non-empty string")
    if path_val.startswith("-") or not os.path.isabs(path_val):
        raise ValueError("'output_path' must be an absolute path (e.g. /abs/path/out.png)")
    return path_val


def validate_ref_name(name_val):
    if not isinstance(name_val, str) or name_val in (".", "..") or not REF_NAME_RE.match(name_val):
        raise ValueError("invalid reference set name (use only letters, numbers, '.', '_', '-')")
    return name_val


def env_int(key, default):
    try:
        v = int(os.environ.get(key, ""))
        return v if v > 0 else default
    except Exception:
        return default


def run_cmd(cmd, timeout=900):
    env = os.environ.copy()
    env["SUBPOWERS_NO_AUTOUPDATE"] = env.get("SUBPOWERS_NO_AUTOUPDATE", "1")
    proc = subprocess.Popen(
        cmd,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        env=env,
        start_new_session=True,
    )
    try:
        out, err = proc.communicate(timeout=timeout)
        return proc.returncode, (out or "").strip(), (err or "").strip()
    except subprocess.TimeoutExpired:
        try:
            os.killpg(proc.pid, signal.SIGTERM)
            try:
                proc.communicate(timeout=3)
            except subprocess.TimeoutExpired:
                os.killpg(proc.pid, signal.SIGKILL)
                proc.communicate(timeout=3)
        except Exception:
            proc.kill()
        return 124, "", f"local subprocess timed out after {timeout}s (remote provider job may still be running)"
    except Exception as exc:
        try:
            os.killpg(proc.pid, signal.SIGKILL)
        except Exception:
            pass
        return 1, "", str(exc)


def read_receipt_for(paths):
    for p in paths:
        stem = os.path.splitext(p)[0]
        rec = stem + ".prompt.txt"
        if os.path.isfile(rec):
            try:
                with open(rec, "r", encoding="utf-8", errors="replace") as f:
                    return f.read(4000)
            except Exception:
                pass
    return None


def handle_tool(name, args):
    if args is None:
        args = {}
    if not isinstance(args, dict):
        return False, {"error": "tool 'arguments' must be a JSON object"}

    if name == "subpowers_powers":
        rc, out, err = run_cmd(["bash", SUBPOWERS, "powers"], timeout=60)
        return rc == 0, {"ok": rc == 0, "powers": out.splitlines() if out else [], "stderr": err}

    if name == "subpowers_doctor":
        rc, out, err = run_cmd(["bash", DOCTOR], timeout=180)
        return rc == 0, {"ok": rc == 0, "report": out, "stderr": err}

    if name == "subpowers_refs":
        action = args.get("action", "list")
        cmd = ["bash", SUBPOWERS, "refs", str(action)]
        if action in ("add", "path"):
            rname = validate_ref_name(args.get("name"))
            cmd.append(rname)
            if action == "add":
                files = expect_str_list(args, "files")
                if not files:
                    return False, {"error": "refs add requires non-empty 'files' array"}
                cmd.extend(files)
        elif args.get("name") is not None:
            cmd.append(validate_ref_name(args["name"]))
        rc, out, err = run_cmd(cmd, timeout=60)
        return rc == 0, {"ok": rc == 0, "items": [l for l in out.splitlines() if l], "stderr": err}

    if name == "subpowers_soul":
        action = args.get("action", "list")
        if action == "list":
            rc, out, err = run_cmd(["bash", HF_SOUL, "list", "--json"], timeout=60)
            data = out
            try:
                data = json.loads(out)
            except Exception:
                pass
            return rc == 0, {"ok": rc == 0, "souls": data, "stderr": err}
        if action == "get":
            target = args.get("soul_id") or args.get("name")
            if not target:
                return False, {"error": "soul get requires 'soul_id' or 'name'"}
            rc, out, err = run_cmd(["bash", HF_SOUL, "get", str(target), "--json"], timeout=60)
            data = out
            try:
                data = json.loads(out)
            except Exception:
                pass
            return rc == 0, {"ok": rc == 0, "soul": data, "stderr": err}
        if action == "create":
            cname = args.get("name")
            imgs = expect_str_list(args, "images")
            cinematic = expect_bool(args, "cinematic", False)
            wait = expect_bool(args, "wait", False)
            if not cname or not isinstance(cname, str) or len(imgs) < 5:
                return False, {"error": "soul create requires 'name' and 5 to 20 image paths"}
            cmd = ["bash", HF_SOUL, "create", cname, *imgs]
            if cinematic:
                cmd.append("--cinematic")
            if wait:
                cmd.append("--wait")
            rc, out, err = run_cmd(cmd, timeout=1500 if wait else 240)
            return rc == 0, {"ok": rc == 0, "output": out, "stderr": err}
        return False, {"error": f"unknown soul action: {action}"}

    if name == "subpowers_image":
        prompt = args.get("prompt")
        if not prompt or not isinstance(prompt, str):
            return False, {"error": "'prompt' must be a non-empty string"}
        out_path = args.get("output_path")
        into = args.get("into_project")
        if not out_path and not into:
            return False, {"error": "provide 'output_path' or 'into_project'"}
        if out_path is not None:
            out_path = validate_output_path(out_path)
        ref_paths = expect_str_list(args, "ref_paths")
        with_hf = expect_bool(args, "with_higgsfield", False)
        cinematic = expect_bool(args, "cinematic", False)
        snapshot = expect_bool(args, "snapshot", False)
        painter = args.get("painter")
        hf_only_used = any(args.get(k) for k in ("model", "soul_id", "style_id")) or cinematic
        if hf_only_used:
            if not painter or painter == "auto":
                painter = "higgsfield"
            elif painter == "council":
                if not with_hf:
                    return False, {"error": "model, soul_id, style_id, and cinematic require with_higgsfield=true when painter='council'"}
            elif painter != "higgsfield":
                return False, {"error": "model, soul_id, style_id, and cinematic require painter='higgsfield' or painter='council' with with_higgsfield=true"}
        if args.get("refs") is not None:
            validate_ref_name(args["refs"])
        cmd = ["bash", SUBPOWERS, "image", prompt]
        if out_path:
            cmd.append(out_path)
        if painter:
            cmd.extend(["--painter", str(painter)])
        if with_hf:
            cmd.append("--with-higgsfield")
        if args.get("size"):
            cmd.extend(["--size", str(args["size"])])
        if args.get("model"):
            cmd.extend(["--model", str(args["model"])])
        if args.get("soul_id"):
            cmd.extend(["--soul-id", str(args["soul_id"])])
        if args.get("style_id"):
            cmd.extend(["--style-id", str(args["style_id"])])
        if cinematic:
            cmd.append("--cinematic")
        if args.get("refs"):
            cmd.extend(["--refs", str(args["refs"])])
        for rp in ref_paths:
            cmd.extend(["--ref", rp])
        if args.get("match_set"):
            cmd.extend(["--match-set", str(args["match_set"])])
        if into:
            cmd.extend(["--into", str(into)])
            if args.get("at") is not None:
                cmd.extend(["--at", str(args["at"])])
            if args.get("duration") is not None:
                cmd.extend(["--duration", str(args["duration"])])
            if args.get("layer_name"):
                cmd.extend(["--layer-name", str(args["layer_name"])])
            if args.get("place"):
                cmd.extend(["--place", str(args["place"])])
            if snapshot:
                cmd.append("--snapshot")
        uses_hf = (painter == "higgsfield") or with_hf
        tmo = (env_int("HIGGSFIELD_IMAGE_TIMEOUT", 600) + 300) if uses_hf else 900
        rc, out, err = run_cmd(cmd, timeout=tmo)
        if rc == 124 and uses_hf:
            rc = 5
            err = (err + "; " if err else "") + "Higgsfield credits may already be spent; check `higgsfield generate list` before retrying"
        lines = [l for l in out.splitlines() if l.strip()]
        sheet = next((l for l in lines if l.endswith("-all.jpg")), None)
        return rc == 0, {
            "ok": rc == 0,
            "exit_code": rc,
            "paths": lines,
            "contact_sheet": sheet,
            "receipt": read_receipt_for(lines),
            "stderr": err,
        }

    if name == "subpowers_avatar":
        out_path = validate_output_path(args.get("output_path"))
        refs_name = args.get("refs")
        if refs_name is not None:
            refs_name = validate_ref_name(refs_name)
        ref_paths = expect_str_list(args, "ref_paths")
        with_hf = expect_bool(args, "with_higgsfield", False)
        if not refs_name and not ref_paths:
            return False, {"error": "provide 'refs' (saved reference set) or 'ref_paths' (local photos array)"}
        cmd = ["bash", SUBPOWERS, "avatar"]
        if refs_name:
            cmd.extend([refs_name, out_path])
        else:
            cmd.extend(["--from", ref_paths[0], out_path])
            for extra in ref_paths[1:]:
                cmd.extend(["--ref", extra])
        painter = args.get("painter", "council")
        if painter:
            cmd.extend(["--painter", str(painter)])
        if with_hf:
            cmd.append("--with-higgsfield")
        if args.get("style"):
            cmd.extend(["--style", str(args["style"])])
        if args.get("size"):
            cmd.extend(["--size", str(args["size"])])
        uses_hf = (painter == "higgsfield") or with_hf
        tmo = (env_int("HIGGSFIELD_IMAGE_TIMEOUT", 600) + 300) if uses_hf else 900
        rc, out, err = run_cmd(cmd, timeout=tmo)
        if rc == 124 and uses_hf:
            rc = 5
            err = (err + "; " if err else "") + "Higgsfield credits may already be spent; check `higgsfield generate list` before retrying"
        lines = [l for l in out.splitlines() if l.strip()]
        sheet = next((l for l in lines if l.endswith("-all.jpg")), None)
        return rc == 0, {
            "ok": rc == 0,
            "exit_code": rc,
            "paths": lines,
            "contact_sheet": sheet,
            "background": "#3A3A3C (flat dark neutral gray)",
            "downstream_tip": "When placing this avatar into a real scene, include 'do not copy the plain gray background'.",
            "stderr": err,
        }

    if name == "subpowers_video":
        prompt = args.get("prompt")
        if not prompt or not isinstance(prompt, str):
            return False, {"error": "'prompt' must be a non-empty string"}
        out_path = args.get("output_path")
        into = args.get("into_project")
        if not out_path and not into:
            return False, {"error": "provide 'output_path' or 'into_project'"}
        if out_path is not None:
            out_path = validate_output_path(out_path)
        ref_paths = expect_str_list(args, "ref_paths")
        audio_paths = expect_str_list(args, "audio_paths")
        keep_audio = expect_bool(args, "keep_audio", False)
        snapshot = expect_bool(args, "snapshot", False)
        painter = args.get("painter") or "grok"
        if painter not in ("grok", "higgsfield"):
            return False, {"error": "video 'painter' must be 'grok' or 'higgsfield'"}
        if painter == "higgsfield" and args.get("voice"):
            return False, {"error": "'voice' is Grok-only and not supported with painter='higgsfield'"}
        hf_video_only = any(args.get(k) for k in ("model", "mode", "character_image", "location_image")) or bool(audio_paths)
        if painter == "grok" and hf_video_only:
            return False, {"error": "'model', 'mode', 'character_image', 'location_image', and 'audio_paths' are Higgsfield-only; explicitly pass painter='higgsfield'"}
        if args.get("refs") is not None:
            validate_ref_name(args["refs"])
        cmd = ["bash", SUBPOWERS, "video", prompt]
        if out_path:
            cmd.append(out_path)
        cmd.extend(["--painter", painter])
        if args.get("model"):
            cmd.extend(["--model", str(args["model"])])
        if args.get("mode"):
            cmd.extend(["--mode", str(args["mode"])])
        if args.get("first_frame"):
            cmd.extend(["--first", str(args["first_frame"])])
        if args.get("last_frame"):
            cmd.extend(["--last", str(args["last_frame"])])
        if args.get("character_image"):
            cmd.extend(["--character", str(args["character_image"])])
        if args.get("location_image"):
            cmd.extend(["--location", str(args["location_image"])])
        if args.get("refs"):
            cmd.extend(["--refs", str(args["refs"])])
        for rp in ref_paths:
            cmd.extend(["--ref", rp])
        for ap in audio_paths:
            cmd.extend(["--audio", ap])
        if args.get("voice"):
            cmd.extend(["--voice", str(args["voice"])])
        if args.get("duration") is not None:
            cmd.extend(["--duration", str(args["duration"])])
        if args.get("aspect"):
            cmd.extend(["--aspect", str(args["aspect"])])
        if args.get("resolution"):
            cmd.extend(["--resolution", str(args["resolution"])])
        if into:
            cmd.extend(["--into", str(into)])
            if args.get("at") is not None:
                cmd.extend(["--at", str(args["at"])])
            if args.get("place"):
                cmd.extend(["--place", str(args["place"])])
            if keep_audio:
                cmd.append("--keep-audio")
            if snapshot:
                cmd.append("--snapshot")
        if painter == "higgsfield":
            tmo = env_int("SUBPOWERS_MCP_HF_VIDEO_TIMEOUT", env_int("HIGGSFIELD_VIDEO_TIMEOUT", 1200) + 300)
        else:
            tmo = env_int("GROK_VIDEO_TIMEOUT", 900) + 180
        rc, out, err = run_cmd(cmd, timeout=tmo)
        if rc == 124 and painter == "higgsfield":
            rc = 5
            err = (err + "; " if err else "") + "Higgsfield credits may already be spent; check `higgsfield generate list` before retrying"
        lines = [l for l in out.splitlines() if l.strip()]
        return rc == 0, {
            "ok": rc == 0,
            "exit_code": rc,
            "paths": lines,
            "receipt": read_receipt_for(lines),
            "stderr": err,
        }

    return False, {"error": f"unknown tool: {name}"}


def read_message(stream):
    """Read one JSON-RPC message; auto-detect Content-Length or newline-delimited JSON."""
    while True:
        line = stream.readline()
        if not line:
            return None, None
        stripped = line.strip()
        if not stripped:
            continue
        if stripped.startswith((b"{", b"[")):
            try:
                return json.loads(stripped.decode("utf-8")), "jsonl"
            except Exception as exc:
                raise ValueError(("jsonl", str(exc)))
        headers = {}
        cur = line
        while cur and cur.strip():
            if b":" in cur:
                k, v = cur.decode("utf-8", errors="replace").split(":", 1)
                headers[k.strip().lower()] = v.strip()
            cur = stream.readline()
        length = int(headers.get("content-length", "0"))
        if length <= 0:
            continue
        body = stream.read(length)
        if not body:
            return None, None
        try:
            return json.loads(body.decode("utf-8")), "framed"
        except Exception as exc:
            raise ValueError(("framed", str(exc)))


def write_message(stream, payload, mode):
    raw = json.dumps(payload, separators=(",", ":")).encode("utf-8")
    if mode == "framed":
        header = f"Content-Length: {len(raw)}\r\n\r\n".encode("ascii")
        stream.write(header + raw)
    else:
        stream.write(raw + b"\n")
    stream.flush()


def dispatch(msg):
    if not isinstance(msg, dict):
        return {
            "jsonrpc": "2.0",
            "id": None,
            "error": {"code": -32600, "message": "Invalid Request: expected JSON object"},
        }
    req_id = msg.get("id")
    # Notifications have no id and expect no reply, even on malformed params.
    if req_id is None and "id" not in msg:
        return None
    if msg.get("jsonrpc") != "2.0":
        return {
            "jsonrpc": "2.0",
            "id": req_id,
            "error": {"code": -32600, "message": "Invalid Request: jsonrpc must be '2.0'"},
        }
    method = msg.get("method")
    params = msg.get("params") if "params" in msg else {}
    if params is None:
        params = {}
    if not isinstance(params, dict):
        return {
            "jsonrpc": "2.0",
            "id": req_id,
            "error": {"code": -32602, "message": "Invalid params: expected JSON object"},
        }

    if method == "initialize":
        client_ver = params.get("protocolVersion") or "2024-11-05"
        proto = client_ver if client_ver in SUPPORTED_PROTOCOLS else "2024-11-05"
        return {
            "jsonrpc": "2.0",
            "id": req_id,
            "result": {
                "protocolVersion": proto,
                "capabilities": {"tools": {"listChanged": False}},
                "serverInfo": SERVER_INFO,
            },
        }

    if method == "ping":
        return {"jsonrpc": "2.0", "id": req_id, "result": {}}

    if method == "tools/list":
        return {"jsonrpc": "2.0", "id": req_id, "result": {"tools": TOOLS}}

    if method == "tools/call":
        tname = params.get("name", "")
        targs = params.get("arguments")
        try:
            ok, payload = handle_tool(tname, targs)
        except ValueError as exc:
            ok, payload = False, {"error": str(exc)}
        except Exception as exc:
            ok, payload = False, {"error": f"internal tool error: {exc}"}
        return {
            "jsonrpc": "2.0",
            "id": req_id,
            "result": {
                "content": [{"type": "text", "text": json.dumps(payload, indent=2)}],
                "isError": not ok,
            },
        }

    return {
        "jsonrpc": "2.0",
        "id": req_id,
        "error": {"code": -32601, "message": f"Method not found: {method}"},
    }


def main():
    stdin = sys.stdin.buffer
    stdout = sys.stdout.buffer
    while True:
        try:
            msg, mode = read_message(stdin)
        except ValueError as exc:
            err_mode, err_msg = exc.args[0] if (exc.args and isinstance(exc.args[0], tuple)) else ("jsonl", str(exc))
            err_resp = {
                "jsonrpc": "2.0",
                "id": None,
                "error": {"code": -32700, "message": f"Parse error: {err_msg}"},
            }
            write_message(stdout, err_resp, err_mode)
            continue
        except Exception as exc:
            err_resp = {
                "jsonrpc": "2.0",
                "id": None,
                "error": {"code": -32700, "message": f"Parse error: {exc}"},
            }
            write_message(stdout, err_resp, "jsonl")
            continue
        if msg is None:
            break
        resp = dispatch(msg)
        if resp is not None:
            write_message(stdout, resp, mode or "jsonl")


if __name__ == "__main__":
    main()
