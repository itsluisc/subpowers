#!/usr/bin/env bash
# subpowers: the AI subscriptions you already pay for, as powers for every agent.
#
# Usage:
#   subpowers image "<prompt>" out.png [--painter P|council] [--size WxH] [--ref IMG]... [--refs NAME]
#   subpowers sheet NAME out.png [--painter P|all]      character sheet (front, sides, 3/4, close-up)
#   subpowers storyboard shots.txt OUTDIR [--refs NAME] [--painter P] [--size WxH] [--style "..."]
#   subpowers refs add NAME IMG...  |  refs list [NAME]  |  refs path NAME
#   subpowers slideshow OUT.webp IMG... [--width 880]    looping slider of your picks (plays in any README)
#   subpowers stopmotion "<concept>" out.mp4 [--frames 8] [--fps 6] [--chain] [--plan frames.txt] [--refs NAME] [--audio bed.m4a] [--resume]
#                                                       handmade stop-motion: frames painted from frame 1, then an mp4 + webp loop
#   subpowers think "<question>" [--json-schema FILE]    a text answer on the same subscriptions (plans frames, slides)
#   subpowers video "<prompt>" out.mp4 [--first IMG] [--refs NAME] [--duration 1-15] [--aspect 16:9]  a short Grok video with sound
#   subpowers library find [WORDS] [--painter P] [--tag k=v]  every image you made, with its tags
#   subpowers doctor [--fix] [--smoke]  |  powers  |  update
#   subpowers canary [--live] [--json] [--notify]  drift radar (vendor CLIs changing); --install-launchagent
#
# Painters (each runs on YOUR login, never an API key):
#   chatgpt      OpenAI's current image model through the codex CLI (ChatGPT plan). 60-100 s.
#   antigravity  Google's Nano Banana 2 through the Antigravity CLI (Google AI plan). ~20-40 s.
#   grok         xAI's Grok Imagine through the Grok CLI (SuperGrok plan). ~35-45 s.
# --painter auto (default): the first connected painter; if it fails (paused plan, quota), the next.
# --painter council (or all): every connected painter paints the same prompt in parallel, plus a side-by-side
#   sheet, so you pick the best one. SUBPOWERS_PAINTER sets the default.
set -euo pipefail

src="${BASH_SOURCE[0]}"
while [[ -L "$src" ]]; do
  d="$(cd "$(dirname "$src")" && pwd)"; src="$(readlink "$src")"
  [[ "$src" != /* ]] && src="$d/$src"
done
here="$(cd "$(dirname "$src")" && pwd)"
HOME_DIR="${SUBPOWERS_HOME:-$HOME/.subpowers}"
ORDER="chatgpt antigravity grok"

# The help is the header comment, read up to its first non-comment line so it cannot drift.
usage() { awk 'NR == 1 { next } !/^#/ { exit } { sub(/^# ?/, ""); print }' "$here/subpowers" >&2; exit "${1:-2}"; }
say() { echo "subpowers: $*" >&2; }

has_chatgpt() {
  local o; command -v codex >/dev/null 2>&1 || return 1
  o="$(codex login status 2>&1)" || true
  grep -qi chatgpt <<<"$o"
}
# A plan counts as ON only when its CLI answers as logged in (installed is not enough:
# a cancelled plan's CLI is still installed). Answers are cached for 10 minutes in
# ~/.cache/subpowers so a fan-out checks once; a painter that reports the plan
# feature is missing marks itself OFF there too.
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/subpowers"
login_cached() {  # login_cached <painter> <check-fn>
  local f="$CACHE_DIR/login-$1"
  if [[ -n "$(find "$f" -mmin -10 2>/dev/null)" ]]; then [[ "$(cat "$f")" == on ]]; return; fi
  mkdir -p "$CACHE_DIR"
  if "$2"; then echo on >"$f"; else echo off >"$f"; return 1; fi
}
mark_off() { mkdir -p "$CACHE_DIR"; echo off >"$CACHE_DIR/login-$1"; }
# Stock macOS has no timeout(1); perl's alarm does the same job there.
tmo() {
  if command -v timeout >/dev/null 2>&1; then timeout 45 "$@"
  elif command -v perl >/dev/null 2>&1; then perl -e 'alarm shift; exec @ARGV' 45 "$@"
  else "$@"; fi
}
# Output is captured before grep: under pipefail, `cli | grep -q` fails when grep exits
# early and the CLI dies of SIGPIPE, which read a logged-in plan as OFF (2026-09-26).
chk_antigravity() {
  local a o; a="$(command -v agy 2>/dev/null || echo "$HOME/.local/bin/agy")"
  [[ -x "$a" ]] || return 1
  local rc=0
  o="$(cd "${TMPDIR:-/tmp}" && tmo "$a" models 2>&1)" || rc=$?
  # A probe that timed out (124 = timeout, 142 = perl alarm) says the machine is busy, NOT that the
  # plan is logged out. Reading it as OFF cached a false "not connected" for 10 minutes and skipped
  # the fastest painter (2026-10-02, load average 80 to 130). Assume connected; the real call tells the truth.
  if [[ $rc -eq 124 || $rc -eq 142 ]]; then return 0; fi
  grep -q '^gemini-' <<<"$o"
}
chk_grok() {
  local o; command -v grok >/dev/null 2>&1 || return 1
  local rc=0
  o="$(cd "${TMPDIR:-/tmp}" && tmo grok models 2>&1)" || rc=$?
  if [[ $rc -eq 124 || $rc -eq 142 ]]; then return 0; fi   # timed out = busy machine, not logged out
  grep -qi 'logged in with grok.com' <<<"$o"
}
has_antigravity() { login_cached antigravity chk_antigravity; }
has_grok() { login_cached grok chk_grok; }
has() { case "$1" in chatgpt) has_chatgpt ;; antigravity) has_antigravity ;; grok) has_grok ;; *) return 1 ;; esac; }
connected() { local p out=""; for p in $ORDER; do has "$p" && out="$out $p"; done; echo "${out# }"; }
norm_painter() {
  case "$1" in
    openai|gpt) echo chatgpt ;;
    google|gemini|nano-banana|nanobanana) echo antigravity ;;
    xai|imagine|grok-imagine|supergrok) echo grok ;;
    council|everyone|every) echo all ;;   # council: every subscription paints it, you pick the best
    *) echo "$1" ;;
  esac
}

# Reference sets: $SUBPOWERS_HOME/refs/NAME/*.{jpg,jpeg,png,webp,heic}. Hidden and ._ files are skipped.
ref_files() {
  local dir="$HOME_DIR/refs/$1"
  [[ -d "$dir" ]] || { say "no reference set '$1' (make one: subpowers refs add $1 photo1.jpg photo2.jpg)"; return 3; }
  find "$dir" -maxdepth 1 -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' -o -iname '*.heic' \) ! -name '.*' | sort
}

# Run one painter; on a non-usage failure in auto mode, try the next connected painter.
# Antigravity takes at most 3 references, so extra ones are dropped for it (with a note).
paint() {  # paint <painter|auto> <prompt> <out> [painter args...]
  local want="$1" prompt="$2" out="$3"; shift 3
  local tries rc p got
  if [[ "$want" == auto ]]; then tries="$(connected)"; else tries="$want"; fi
  [[ -n "$tries" ]] || { say "no painter is connected. Run: subpowers doctor"; return 3; }
  for p in $tries; do
    has "$p" || { say "$p is not connected (paused or logged out); skipping"; continue; }
    local args=() nref=0 a skip=""
    for a in "$@"; do
      if [[ -n "$skip" ]]; then
        skip=""; nref=$((nref+1))
        if [[ "$p" == antigravity && $nref -gt 3 ]]; then continue; fi
        args+=(--ref "$a"); continue
      fi
      if [[ "$a" == --ref ]]; then skip=1; continue; fi
      args+=("$a")
    done
    if [[ "$p" == antigravity && $nref -gt 3 ]]; then say "antigravity takes 3 references; using the first 3 of $nref"; fi
    # The painter prints the file it delivered, which keeps its real extension
    # when this machine cannot convert it (no Pillow, no sips).
    set +e
    got="$(bash "$here/${p}-image" "$prompt" "$out" ${args[@]+"${args[@]}"})"
    rc=$?
    set -e
    if [[ -n "$got" ]]; then echo "$got"; fi
    if [[ $rc -eq 0 ]]; then
      python3 "$here/library" add "${got:-$out}" >/dev/null || true   # index it; never fails the image
      return 0
    fi
    [[ $rc -eq 4 ]] && mark_off "$p"   # the plan lacks this feature (e.g. image gen not on this tier)
    [[ $rc -eq 2 ]] && return 2
    [[ $rc -eq 5 ]] && return 5   # painted but not delivered: the plan already paid, never paint it twice
    if [[ "$want" == auto ]]; then say "$p failed (exit $rc); trying the next painter"; else return $rc; fi
  done
  say "every connected painter failed"; return 1
}

# Side-by-side sheet of several images with labels. Needs Pillow; without it, says so and skips.
contact_sheet() {  # contact_sheet <out.jpg> <label=path>...
  local out="$1"; shift
  if ! python3 -c 'import PIL' 2>/dev/null; then
    say "no side-by-side sheet: it needs Pillow (python3 -m pip install --user pillow); every image is still saved"
    return 0
  fi
  python3 - "$out" "$@" <<'PY' 2>/dev/null || { say "could not build the side-by-side sheet; every image is still saved"; return 0; }
import sys
from PIL import Image, ImageDraw, ImageFont
out, items = sys.argv[1], [a.split("=", 1) for a in sys.argv[2:]]
try: font = ImageFont.truetype("/System/Library/Fonts/HelveticaNeue.ttc", 28)
except Exception: font = ImageFont.load_default()
H = 640; tiles = []
for label, path in items:
    try: im = Image.open(path).convert("RGB")
    except Exception: continue
    tiles.append((label, im.resize((max(1, int(im.width * H / im.height)), H))))
if not tiles: sys.exit(0)
per_row = 3 if len(tiles) > 4 else len(tiles)
rows = [tiles[i:i + per_row] for i in range(0, len(tiles), per_row)]
W = max(sum(t.width for _, t in r) + 20 * (len(r) - 1) for r in rows)
sheet = Image.new("RGB", (W, len(rows) * (H + 60)), (255, 255, 255)); d = ImageDraw.Draw(sheet); y = 0
for r in rows:
    x = 0
    for label, t in r:
        d.text((x + 6, y + 14), label, fill=(30, 30, 30), font=font); sheet.paste(t, (x, y + 56)); x += t.width + 20
    y += H + 60
sheet.save(out, quality=86); print(out)
PY
}

# Big reference photos make every painter slow: a 4096 px phone photo kept Nano Banana busy for
# minutes (400 s with three references, against 24 s with none). Painters work from about 1280 px
# anyway, so each reference is shrunk once and cached by file and mtime.
small_ref() {
  local f="$1" key out
  [[ -f "$f" ]] || { echo "$f"; return; }
  mkdir -p "$CACHE_DIR/refs-small"
  key="$(printf '%s|%s' "$f" "$(stat -f '%m-%z' "$f" 2>/dev/null || stat -c '%Y-%s' "$f")" | shasum | cut -c1-16)"
  out="$CACHE_DIR/refs-small/$key.jpg"
  if [[ ! -s "$out" ]]; then
    python3 - "$f" "$out" <<'PY' 2>/dev/null || true
import sys
from PIL import Image, ImageOps
im = ImageOps.exif_transpose(Image.open(sys.argv[1])).convert("RGB")
if max(im.size) > 1280:
    im.thumbnail((1280, 1280))
im.save(sys.argv[2], "JPEG", quality=88)
PY
  fi
  if [[ -s "$out" ]]; then echo "$out"; else echo "$f"; fi
}

cmd="${1:-help}"; [[ $# -gt 0 ]] && shift
case "$cmd" in
  image|draw)
    [[ $# -ge 2 ]] || usage
    prompt="$1"; out="$2"; shift 2
    painter="$(norm_painter "${SUBPOWERS_PAINTER:-auto}")"; args=()
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --painter) [[ $# -ge 2 ]] || usage; painter="$(norm_painter "$2")"; shift 2 ;;
        --refs)
          [[ $# -ge 2 ]] || usage
          rf="$(ref_files "$2")" || exit 3
          while IFS= read -r f; do [[ -n "$f" ]] && args+=(--ref "$(small_ref "$f")"); done <<< "$rf"
          shift 2 ;;
        --ref)
          [[ $# -ge 2 ]] || usage
          args+=(--ref "$(small_ref "$2")"); shift 2 ;;
        *) args+=("$1"); shift ;;
      esac
    done
    case "$painter" in
      auto|chatgpt|antigravity|grok) paint "$painter" "$prompt" "$out" ${args[@]+"${args[@]}"} ;;
      all)
        stem="${out%.*}"; ext="${out##*.}"; pids=(); labels=()
        export SUBPOWERS_BATCH="${SUBPOWERS_BATCH:-$(date +%Y%m%d-%H%M%S)-$$}"
        for p in $(connected); do
          ( paint "$p" "$prompt" "${stem}-${p}.${ext}" ${args[@]+"${args[@]}"} ) &
          pids+=($!); labels+=("$p")
        done
        [[ ${#pids[@]} -gt 0 ]] || { say "no painter is connected. Run: subpowers doctor"; exit 3; }
        items=(); i=0; ok=0
        for pid in "${pids[@]}"; do
          p="${labels[$i]}"; i=$((i+1))
          if wait "$pid"; then ok=$((ok+1)); items+=("$p=${stem}-${p}.${ext}"); else say "$p did not finish; the others still count"; fi
        done
        [[ $ok -gt 0 ]] || exit 1
        contact_sheet "${stem}-all.jpg" "${items[@]}" >/dev/null
        if [[ -f "${stem}-all.jpg" ]]; then echo "${stem}-all.jpg"; fi
        ;;
      *) say "unknown painter '$painter' (chatgpt, antigravity, grok, all)"; exit 2 ;;
    esac
    ;;
  sheet)
    [[ $# -ge 2 ]] || usage
    name="$1"; out="$2"; shift 2
    prompt="Character reference sheet of the person in the reference photos, for keeping them consistent across future images. \
One clean studio sheet on a plain light-gray seamless background, even soft light, the same outfit in every view: \
full-body front view, full-body left profile, full-body right three-quarter view, full-body back view, \
and a large head-and-shoulders close-up of the face looking at the camera. Keep the exact face, skin tone, hair and build. \
Photorealistic, evenly spaced, no text, no labels, no watermark."
    exec bash "$here/subpowers" image "$prompt" "$out" --refs "$name" --size "${SUBPOWERS_SHEET_SIZE:-1536x1024}" "$@"
    ;;
  storyboard)
    [[ $# -ge 2 ]] || usage
    shots="$1"; outdir="$2"; shift 2
    [[ -f "$shots" ]] || { say "shot list not found: $shots (one shot description per line)"; exit 2; }
    painter="$(norm_painter "${SUBPOWERS_PAINTER:-auto}")"; style=""; size="1536x1024"; refargs=()
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --painter) painter="$(norm_painter "$2")"; shift 2 ;;
        --style) style="$2"; shift 2 ;;
        --size) size="$2"; shift 2 ;;
        --refs) refargs+=(--refs "$2"); shift 2 ;;
        --ref) refargs+=(--ref "$2"); shift 2 ;;
        *) say "unknown storyboard option: $1"; exit 2 ;;
      esac
    done
    if [[ "$painter" == all ]]; then say "storyboard uses one painter per board; pick one or leave auto"; exit 2; fi
    mkdir -p "$outdir"; n=0; pids=(); files=()
    max="${SUBPOWERS_PARALLEL:-3}"
    while IFS= read -r line || [[ -n "$line" ]]; do
      [[ -z "${line// /}" || "$line" == \#* ]] && continue
      n=$((n+1)); f="$outdir/shot-$(printf '%02d' $n).png"; files+=("Shot $n=$f")
      ( bash "$here/subpowers" image "Storyboard frame, shot $n. $line. ${style}${style:+. }Cinematic still, no text, no letters." "$f" \
          --painter "$painter" --size "$size" ${refargs[@]+"${refargs[@]}"} >/dev/null ) &
      pids+=($!)
      if [[ ${#pids[@]} -ge $max ]]; then wait "${pids[0]}" || say "a shot failed; continuing"; pids=("${pids[@]:1}"); fi
    done < "$shots"
    for pid in ${pids[@]+"${pids[@]}"}; do wait "$pid" || say "a shot failed; continuing"; done
    [[ $n -gt 0 ]] || { say "the shot list is empty"; exit 2; }
    have=()
    for it in "${files[@]}"; do
      f="${it#*=}"; [[ -f "$f" ]] || f="${f%.png}.jpg"   # delivered as jpg where nothing can convert it
      [[ -f "$f" ]] && have+=("${it%%=*}=$f")
    done
    say "${#have[@]} of $n shots painted"
    contact_sheet "$outdir/storyboard.jpg" ${have[@]+"${have[@]}"} >/dev/null
    if [[ -f "$outdir/storyboard.jpg" ]]; then echo "$outdir/storyboard.jpg"; else echo "$outdir"; fi
    ;;
  stopmotion|stop-motion)
    [[ $# -ge 2 ]] || usage
    concept="$1"; out="$2"; shift 2
    painter="$(norm_painter "${SUBPOWERS_PAINTER:-auto}")"; frames=8; fps=6; style=""; size="1024x1024"
    chain=""; plan=""; audio=""; resume=""; refargs=()
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --frames) [[ $# -ge 2 ]] || usage; frames="$2"; shift 2 ;;
        --fps) [[ $# -ge 2 ]] || usage; fps="$2"; shift 2 ;;
        --painter) [[ $# -ge 2 ]] || usage; painter="$(norm_painter "$2")"; shift 2 ;;
        --style) [[ $# -ge 2 ]] || usage; style="$2"; shift 2 ;;
        --size) [[ $# -ge 2 ]] || usage; size="$2"; shift 2 ;;
        --refs|--ref) [[ $# -ge 2 ]] || usage; refargs+=("$1" "$2"); shift 2 ;;
        --plan) [[ $# -ge 2 ]] || usage; plan="$2"; shift 2 ;;
        --audio) [[ $# -ge 2 ]] || usage; audio="$2"; shift 2 ;;
        --chain) chain=1; shift ;;
        --resume) resume=1; shift ;;
        *) say "unknown stopmotion option: $1"; exit 2 ;;
      esac
    done
    [[ "$frames" =~ ^[0-9]+$ && $frames -ge 2 && $frames -le 24 ]] || { say "--frames is 2 to 24"; exit 2; }
    [[ "$fps" =~ ^[0-9]+$ && $fps -ge 1 && $fps -le 30 ]] || { say "--fps is 1 to 30"; exit 2; }
    [[ "$size" =~ ^[0-9]+x[0-9]+$ ]] || { say "--size must look like 1024x1024"; exit 2; }
    [[ -z "$plan" || -f "$plan" ]] || { say "plan not found: $plan (one frame per line)"; exit 2; }
    [[ -z "$audio" || -f "$audio" ]] || { say "audio not found: $audio"; exit 2; }
    # Every frame comes from one painter: a second painter would redraw the set in its own hand.
    if [[ "$painter" == all ]]; then say "stopmotion uses one painter per clip (a second painter breaks the look); pick one or leave auto"; exit 2; fi
    if [[ "$painter" == auto ]]; then
      painter="$(connected)"; painter="${painter%% *}"
      [[ -n "$painter" ]] || { say "no painter is connected. Run: subpowers doctor"; exit 3; }
    fi
    t0=$(date +%s)
    stem="${out%.*}"; fdir="$stem.frames"; mkdir -p "$fdir"
    fdir="$(cd "$fdir" && pwd)"; stem="$(cd "$(dirname "$stem")" && pwd)/$(basename "$stem")"; out="$stem.mp4"

    # 1. The plan: one line per frame, from --plan or planned on a subscription.
    planned_by=""
    if [[ -z "$plan" && -n "$resume" && -s "$fdir/plan.txt" ]]; then
      planned_by="kept from the last run"
    elif [[ -n "$plan" ]]; then
      grep -v '^[[:space:]]*\(#.*\)\{0,1\}$' "$plan" >"$fdir/plan.txt" || true
      planned_by="your list ($plan)"
    else
      printf '{"type":"object","additionalProperties":false,"required":["frames"],"properties":{"frames":{"type":"array","minItems":%d,"maxItems":%d,"items":{"type":"string"}}}}\n' \
        "$frames" "$frames" >"$fdir/plan-schema.json"
      ask="Plan a stop-motion animation of exactly ${frames} frames for this concept: ${concept}
Every frame is one still photo of the same physical set, shot from the same locked-off camera. Between frames only small physical changes happen (an object moves a little, a character changes pose, a light flickers), so played at ${fps} frames per second it reads as smooth handmade stop-motion, and the last frame leads naturally back into the first so it loops.
Nothing is ever drawn on the set to show the motion: no dotted lines, paths, arrows or marks. Describe where things are by the objects around them. Keep each change small; a full turn or a long trip takes many frames. Frame 1 describes the whole scene: the set, camera position and lens, the light, every character and object, materials and colors. Every later frame says only what is different from the frame before, in one sentence.
Reply as JSON: {\"frames\": [${frames} strings, in order]}."
      if ! json="$(bash "$here/think" "$ask" --json-schema "$fdir/plan-schema.json" 2>"$fdir/plan.log")"; then
        say "could not plan the frames: $(tail -n 1 "$fdir/plan.log") (or write them yourself, one per line, and pass --plan FILE)"; exit 1
      fi
      planned_by="$(sed -n 's/^think: \([a-z]*\) answered.*/\1/p' "$fdir/plan.log" | tail -n 1)"
      python3 -c 'import json, sys
for f in json.loads(sys.argv[1])["frames"]: print(" ".join(str(f).split()))' "$json" >"$fdir/plan.txt"
    fi
    descs=(); while IFS= read -r line || [[ -n "$line" ]]; do [[ -n "${line// /}" ]] && descs+=("$line"); done <"$fdir/plan.txt"
    n=${#descs[@]}
    [[ $n -ge 2 ]] || { say "a stop-motion clip needs at least 2 frames; the plan has $n"; exit 1; }
    say "planned $n frames${planned_by:+ ($planned_by)}; painting them on $painter ($([[ -n "$chain" ]] && echo 'each from the one before' || echo 'all from frame 1'))"

    # 2. Frame 1 sets the scene; every later frame is painted with a frame as its first reference.
    look="${style:-Handmade stop-motion animation: a real miniature set, tactile materials, soft practical light, shallow depth of field}"
    frame_file() { local e; for e in png jpg jpeg webp; do [[ -f "$fdir/frame-$1.$e" ]] && { echo "$fdir/frame-$1.$e"; return 0; }; done; return 1; }
    paint_frame() {  # paint_frame K ANCHOR_FILE|""
      local k="$1" anchor="$2" nn p
      nn="$(printf '%02d' "$k")"
      if [[ -n "$resume" ]] && frame_file "$nn" >/dev/null; then return 0; fi   # painted by the last run
      if [[ -z "$anchor" ]]; then
        p="Stop-motion animation, frame 1 of $n. ${descs[0]}. ${look}. Locked-off camera. Nothing drawn on the set: no lines, paths, arrows or marks. No text, no letters, no captions."
        bash "$here/subpowers" image "$p" "$fdir/frame-$nn.png" --painter "$painter" --size "$size" ${refargs[@]+"${refargs[@]}"} >/dev/null
      else
        p="Stop-motion animation, frame $k of $n. The first reference image is frame $([[ -n "$chain" ]] && echo $((k-1)) || echo 1) of this same animation: keep its set, camera position, framing, lens, light, characters, materials and colors exactly the same. Change only this: ${descs[$((k-1))]}. Add nothing else: no lines, paths, arrows or marks. ${look}. No text, no letters, no captions."
        bash "$here/subpowers" image "$p" "$fdir/frame-$nn.png" --painter "$painter" --size "$size" --ref "$anchor" ${refargs[@]+"${refargs[@]}"} >/dev/null
      fi
    }
    paint_frame 1 "" || { say "frame 1 did not paint; nothing to animate"; exit 1; }
    first="$(frame_file 01)" || { say "frame 1 did not paint; nothing to animate"; exit 1; }
    if [[ -n "$chain" ]]; then
      prev="$first"
      for ((k = 2; k <= n; k++)); do
        paint_frame "$k" "$prev" || say "frame $k failed; the clip goes on without it"
        prev="$(frame_file "$(printf '%02d' "$k")")" || prev="$prev"
      done
    else
      max="${SUBPOWERS_PARALLEL:-3}"; pids=()
      for ((k = 2; k <= n; k++)); do
        ( paint_frame "$k" "$first" ) & pids+=($!)
        if [[ ${#pids[@]} -ge $max ]]; then wait "${pids[0]}" || say "a frame failed; the clip goes on without it"; pids=("${pids[@]:1}"); fi
      done
      for pid in ${pids[@]+"${pids[@]}"}; do wait "$pid" || say "a frame failed; the clip goes on without it"; done
    fi
    got=(); for ((k = 1; k <= n; k++)); do f="$(frame_file "$(printf '%02d' "$k")")" && got+=("$f"); done
    say "${#got[@]} of $n frames painted"
    [[ ${#got[@]} -ge 2 ]] || { say "fewer than 2 frames painted; no clip"; exit 1; }

    # 3. The clip: an mp4 (H.264, yuv420p, faststart) with ffmpeg, a looping webp with Pillow.
    w="${size%x*}"; h="${size#*x}"; w=$((w / 2 * 2)); h=$((h / 2 * 2))
    loops=$(( (3 * fps + ${#got[@]} - 1) / ${#got[@]} )); [[ $loops -ge 1 ]] || loops=1   # at least ~3 s of clip
    made=(); mp4ok=""
    if command -v ffmpeg >/dev/null 2>&1; then
      # An image sequence (numbered links in one folder, one extension), never a concat list:
      # a stills-to-clip encode is not a cut, and it stays clear of any cut guard on the machine.
      seq="$fdir/seq"; rm -rf "$seq"; mkdir -p "$seq"; ext="${got[0]##*.}"; i=0
      for ((l = 0; l < loops; l++)); do
        for f in "${got[@]}"; do
          i=$((i+1)); dst="$seq/$(printf '%04d' "$i").$ext"
          if [[ "${f##*.}" == "$ext" ]]; then ln -s "$f" "$dst"
          else python3 "$here/imgops" convert "$f" "$dst" 2>/dev/null || i=$((i-1)); fi
        done
      done
      aargs=(); amap=(); [[ -n "$audio" ]] && { aargs=(-stream_loop -1 -i "$audio"); amap=(-map 0:v:0 -map 1:a:0 -c:a aac -b:a 160k -shortest); }
      vf="scale=${w}:${h}:force_original_aspect_ratio=decrease,pad=${w}:${h}:(ow-iw)/2:(oh-ih)/2:color=white,setsar=1,format=yuv420p"
      if ffmpeg -y -loglevel error -framerate "$fps" -i "$seq/%04d.$ext" ${aargs[@]+"${aargs[@]}"} -vf "$vf" \
           -c:v libx264 -crf 18 -preset medium -pix_fmt yuv420p -r "$fps" ${amap[@]+"${amap[@]}"} \
           -movflags +faststart "$out" </dev/null 2>"$fdir/ffmpeg.log" && [[ -s "$out" ]]; then
        made+=("$out"); mp4ok=1
      else
        say "ffmpeg could not make the mp4 ($(tail -n 1 "$fdir/ffmpeg.log")); the frames and the webp still ship"
      fi
    else
      say "no mp4: it needs ffmpeg (brew install ffmpeg, or apt install ffmpeg); the frames and the webp still ship"
    fi
    if python3 -c 'import PIL' 2>/dev/null; then
      ww=$(( w < 720 ? w : 720 ))
      if python3 "$here/slideshow" "$stem.webp" "${got[@]}" --transition cut --hold "$(python3 -c "print(1/$fps)")" \
           --fps "$fps" --width "$ww" >/dev/null 2>"$fdir/webp.log"; then
        made+=("$stem.webp")
      fi
    else
      say "no looping webp: it needs Pillow (python3 -m pip install --user pillow)"
    fi

    # 4. The receipt, the library, and what to open.
    main="${made[0]:-$fdir}"
    { echo "subpowers stopmotion receipt"
      echo "door: subpowers stopmotion ($painter)"
      echo "mode: $([[ -n "$chain" ]] && echo 'chained (each frame painted from the one before)' || echo 'anchored (every frame painted from frame 1)')"
      echo "frames: ${#got[@]} painted of $n planned, $fps fps$([[ -n "$mp4ok" ]] && echo ", $loops loop(s) in the mp4")"
      echo "plan: ${planned_by:-?}"
      echo "size: $size"
      echo "look: $look"
      echo "delivered: ${made[*]:-frames only}"
      echo "frames dir: $fdir (each frame has its own receipt)"
      echo "audio: ${audio:-none (add --audio FILE for a bed)}"
      echo "took: $(( $(date +%s) - t0 )) s"
      echo
      echo "PROMPT (as given):"
      echo "$concept"
      echo
      echo "PLAN:"
      i=0; for d in "${descs[@]}"; do i=$((i+1)); echo "$i. $d"; done
    } >"$stem.prompt.txt"
    for f in ${made[@]+"${made[@]}"}; do python3 "$here/library" add "$f" >/dev/null 2>&1 || true; done
    echo "$main"
    ;;
  refs)
    sub="${1:-list}"; [[ $# -gt 0 ]] && shift
    case "$sub" in
      add)
        [[ $# -ge 2 ]] || { say "usage: subpowers refs add NAME IMG..."; exit 2; }
        name="$1"; shift; dir="$HOME_DIR/refs/$name"; mkdir -p "$dir"
        for img in "$@"; do
          [[ -f "$img" ]] || { say "missing: $img"; continue; }
          base="$(basename "$img")"; ext="$(printf '%s' "${base##*.}" | tr '[:upper:]' '[:lower:]')"
          if [[ "$ext" == heic || "$ext" == heif ]] && command -v sips >/dev/null 2>&1; then
            sips -s format jpeg "$img" --out "$dir/${base%.*}.jpg" >/dev/null && echo "$dir/${base%.*}.jpg"
          else cp "$img" "$dir/$base" && echo "$dir/$base"; fi
        done
        ;;
      list)
        if [[ $# -ge 1 ]]; then ref_files "$1"; else ls -1 "$HOME_DIR/refs" 2>/dev/null || say "no reference sets yet"; fi
        ;;
      path) [[ $# -ge 1 ]] || usage; echo "$HOME_DIR/refs/$1" ;;
      *) say "refs: add | list | path"; exit 2 ;;
    esac
    ;;
  video)
    [[ $# -ge 2 ]] || usage
    prompt="$1"; out="$2"; shift 2
    vargs=(); has_src=""; aspect="16:9"; fpainter="$(norm_painter "${SUBPOWERS_PAINTER:-auto}")"
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --first|--last|--ref|--voice) [[ $# -ge 2 ]] || usage; has_src=1; vargs+=("$1" "$2"); shift 2 ;;
        --refs)
          [[ $# -ge 2 ]] || usage
          rf="$(ref_files "$2")" || exit 3
          while IFS= read -r f; do [[ -n "$f" ]] && { vargs+=(--ref "$f"); has_src=1; }; done <<< "$rf"
          shift 2 ;;
        --aspect) [[ $# -ge 2 ]] || usage; aspect="$2"; vargs+=("$1" "$2"); shift 2 ;;
        --painter) [[ $# -ge 2 ]] || usage; fpainter="$(norm_painter "$2")"; shift 2 ;;
        *) vargs+=("$1"); shift ;;
      esac
    done
    if [[ -z "$has_src" ]]; then
      # Video starts from an image: paint the first frame in the clip's shape, then animate it.
      case "$aspect" in
        9:16) fsize=1080x1920 ;; 1:1) fsize=1024x1024 ;; 4:3) fsize=1600x1200 ;; 3:4) fsize=1200x1600 ;;
        3:2) fsize=1536x1024 ;; 2:3) fsize=1024x1536 ;; *) fsize=1920x1080 ;;
      esac
      [[ "$fpainter" == all ]] && fpainter=auto
      say "no image given: painting the first frame ($fsize) before animating it"
      frame="$(paint "$fpainter" "$prompt" "${out%.*}.first.png" --size "$fsize" | tail -n 1)" || exit $?
      vargs+=(--first "$frame")
    fi
    got="$(bash "$here/grok-video" "$prompt" "$out" ${vargs[@]+"${vargs[@]}"})" || exit $?
    python3 "$here/library" add "$got" >/dev/null || true
    echo "$got"
    ;;
  think|plan) exec bash "$here/think" "$@" ;;
  slideshow|slider) exec python3 "$here/slideshow" "$@" ;;
  library|lib) exec python3 "$here/library" "$@" ;;
  canary) exec python3 "$here/canary" "$@" ;;
  doctor) exec bash "$here/doctor" "$@" ;;
  powers)
    for p in $ORDER; do
      if has "$p"; then printf 'image  %-12s ON\n' "$p"; else printf 'image  %-12s OFF  (subpowers doctor shows how to connect it)\n' "$p"; fi
    done
    ;;
  update)
    root="$(cd "$here/.." && pwd)"
    # core.fileMode=false: the installer's chmod is not a local edit; real edits still stop the pull.
    if [[ -d "$root/.git" ]]; then git -C "$root" -c core.fileMode=false pull --ff-only && bash "$root/install.sh" --no-doctor
    else say "not a git install; re-run the installer from a fresh download"; exit 1; fi
    ;;
  help|-h|--help) usage 0 ;;
  *) say "unknown command '$cmd'"; usage ;;
esac
